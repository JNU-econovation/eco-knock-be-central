{
  "uid": "eco-knock-performance",
  "title": "Eco Knock Pipelines",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "15s",
  "panels": [
    {
      "id": 7,
      "title": "gRPC client duration p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, client, operation) (rate(eco_knock_grpc_client_seconds_bucket{job=\"eco-knock-app\"}[5m])))",
          "legendFormat": "{{client}} {{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 8,
      "title": "Polling and queue failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (queue) (rate(eco_knock_queue_processing_seconds_count{job=\"eco-knock-app\",outcome=\"failure\"}[5m]))",
          "legendFormat": "queue {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (client) (rate(eco_knock_grpc_client_seconds_count{job=\"eco-knock-app\",outcome=\"failure\"}[5m]))",
          "legendFormat": "grpc {{client}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 9,
      "title": "Auto control actions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (decision, outcome) (rate(eco_knock_auto_control_action_seconds_count{job=\"eco-knock-app\"}[5m]))",
          "legendFormat": "{{decision}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 10,
      "title": "Air quality aggregation duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (resolution, outcome) (rate(eco_knock_air_quality_aggregation_seconds_sum{job=\"eco-knock-app\"}[5m])) / sum by (resolution, outcome) (rate(eco_knock_air_quality_aggregation_seconds_count{job=\"eco-knock-app\"}[5m]))",
          "legendFormat": "{{resolution}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 11,
      "title": "Embedded service status",
      "type": "stat",
      "targets": [
        {
          "expr": "max(up{job=\"eco-knock-embedded\"})",
          "legendFormat": "embedded",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 12,
      "title": "Embedded process CPU",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total{job=\"eco-knock-embedded\"}[5m]))",
          "legendFormat": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 13,
      "title": "Embedded process memory",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"eco-knock-embedded\"}",
          "legendFormat": "memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 14,
      "title": "Embedded goroutines",
      "type": "timeseries",
      "targets": [
        {
          "expr": "go_goroutines{job=\"eco-knock-embedded\"}",
          "legendFormat": "goroutines",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ],
  "description": "공기질·조도 파이프라인과 embedded 연동 지표. 서버 공통 지표는 Overview / Application / Infrastructure 대시보드로 옮겼다.",
  "tags": [
    "eco-knock"
  ],
  "links": [
    {
      "title": "Eco Knock",
      "type": "dashboards",
      "tags": [
        "eco-knock"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
